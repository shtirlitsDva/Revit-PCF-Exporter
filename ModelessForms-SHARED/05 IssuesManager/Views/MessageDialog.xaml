<!-- Themed replacement for MessageBox (a system MessageBox would be light). -->
<Window x:Class="ModelessForms.IssuesManager.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" MaxHeight="640"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="18,16,18,14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ConfirmButton" MinWidth="90" Click="OnConfirm" IsDefault="True"/>
            <Button x:Name="CancelButton" MinWidth="90" Margin="8,0,0,0" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
        </ScrollViewer>
    </DockPanel>
</Window>
