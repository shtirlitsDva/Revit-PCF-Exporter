<!--
    Issue Tracker main window. All styling comes from the shared theme
    (revit-shared-utilities-shared/02 Theme), applied by ThemeManager before
    InitializeComponent. No colours, fonts or templates are set here.
-->
<Window x:Class="ModelessForms.IssuesManager.Views.IssueTrackerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ModelessForms.IssuesManager.ViewModels"
        xmlns:v="clr-namespace:ModelessForms.IssuesManager.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:IssueTrackerViewModel}"
        Title="Issue Tracker"
        Width="1100" Height="760" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">

    <Window.Resources>
        <v:VisibleWhenConverter x:Key="VisibleWhen"/>
        <v:VisibleWhenConverter x:Key="HiddenWhen" Invert="True"/>
        <v:ThumbnailConverter x:Key="Thumbnail"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== Header: collection ===================== -->
        <Border Grid.Row="0" Style="{DynamicResource Surface.Header}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Collection" Style="{DynamicResource Text.Secondary}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding CollectionNames}"
                          SelectedItem="{Binding SelectedCollectionName}"
                          IsEnabled="{Binding CanSwitchCollection}"
                          ToolTip="The open collection"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="New…" Command="{Binding NewCollectionCommand}" ToolTip="Create a new collection"/>
                    <Button Content="Properties…" Command="{Binding EditCollectionCommand}" Margin="6,0,0,0"
                            ToolTip="Project name and author of the open collection"/>
                    <Button Content="Delete" Command="{Binding DeleteCollectionCommand}" Margin="6,0,0,0"
                            Style="{DynamicResource Button.Danger}"
                            ToolTip="Delete the open collection with all issues and screenshots"/>
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding CollectionInfo}" Style="{DynamicResource Text.Muted}"
                           VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="4" Content="Settings…" Command="{Binding OpenSettingsCommand}"
                        ToolTip="{Binding StorageFolder}"/>
            </Grid>
        </Border>

        <!-- ===================== Save error banner ===================== -->
        <Border Grid.Row="1" Style="{DynamicResource Surface.Banner.Danger}"
                Visibility="{Binding SaveError, Converter={StaticResource VisibleWhen}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Retry save" Command="{Binding RetrySaveCommand}" Margin="10,0,0,0"/>
                <TextBlock Text="{Binding SaveError}" Style="{DynamicResource Text.Warn}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ===================== Main: list + detail ===================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="220"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- Issue list -->
            <DockPanel Grid.Column="0" Margin="10,10,6,10">
                <TextBlock DockPanel.Dock="Top" Text="Issues" Style="{DynamicResource Text.Heading}" Margin="2,0,0,6"/>
                <Grid>
                    <ListBox ItemsSource="{Binding Issues}"
                             SelectedItem="{Binding SelectedIssue}"
                             Visibility="{Binding HasCollection, Converter={StaticResource VisibleWhen}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:IssueViewModel}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding CreatedText}" Style="{DynamicResource Text.Muted.InList}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="No collection is open. Click New… to create one."
                               Style="{DynamicResource Text.Muted}" TextWrapping="Wrap" Margin="2,8"
                               Visibility="{Binding HasCollection, Converter={StaticResource HiddenWhen}}"/>
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

            <!-- Issue detail -->
            <TextBlock Grid.Column="2" Margin="16" Style="{DynamicResource Text.Muted}"
                       Text="Select an issue, or click New issue to document the elements selected in Revit."
                       TextWrapping="Wrap"
                       Visibility="{Binding HasSelectedIssue, Converter={StaticResource HiddenWhen}}"/>

            <Grid Grid.Column="2" Margin="10,10,12,10" DataContext="{Binding SelectedIssue}"
                  Visibility="{Binding Converter={StaticResource VisibleWhen}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="90"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{Binding Title}" Style="{DynamicResource Text.Title}"/>
                    <TextBlock Style="{DynamicResource Text.Muted}" Margin="0,2,0,0">
                        <Run Text="Created"/> <Run Text="{Binding CreatedText, Mode=OneWay}"/>
                        <Run Text="   ·   "/><Run Text="{Binding IdText, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <!-- Description -->
                <DockPanel Grid.Row="1" Margin="0,0,0,6"
                           DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock DockPanel.Dock="Left" Text="Description" Style="{DynamicResource Text.Heading}" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="{Binding DictationLabel}" Command="{Binding ToggleDictationCommand}"
                            ToolTip="Dictate with the microphone (Azure Speech). Click again to stop."/>
                    <Border DockPanel.Dock="Right" Style="{DynamicResource Surface.Recording}" Margin="0,0,8,0"
                            VerticalAlignment="Center" ToolTip="Recording"
                            Visibility="{Binding IsRecording, Converter={StaticResource VisibleWhen}}"/>
                    <Border/>
                </DockPanel>
                <TextBox Grid.Row="2" Style="{DynamicResource TextBox.MultiLine}"
                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Screenshots -->
                <DockPanel Grid.Row="3" Margin="0,14,0,6"
                           DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock DockPanel.Dock="Left" Text="Screenshots" Style="{DynamicResource Text.Heading}" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="Remove" Command="{Binding RemoveScreenshotCommand}" Margin="6,0,0,0"
                            Style="{DynamicResource Button.Danger}" ToolTip="Delete the selected screenshot"/>
                    <Button DockPanel.Dock="Right" Content="Add screenshot…" Command="{Binding AddScreenshotCommand}"
                            ToolTip="Hide this window and drag a rectangle on the screen. Esc cancels."/>
                    <Border/>
                </DockPanel>
                <ListBox Grid.Row="4" Height="112"
                         ItemsSource="{Binding Screenshots}"
                         SelectedItem="{Binding DataContext.SelectedScreenshot, RelativeSource={RelativeSource AncestorType=Window}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ScreenshotViewModel}">
                            <Border Style="{DynamicResource Surface.Thumbnail}" ToolTip="{Binding FileName}">
                                <Grid>
                                    <Grid Visibility="{Binding Exists, Converter={StaticResource VisibleWhen}}">
                                        <Image x:Name="thumb" Source="{Binding Path, Converter={StaticResource Thumbnail}}" Stretch="Uniform"/>
                                        <!-- The file exists but cannot be read as an image (damaged, locked). -->
                                        <TextBlock Text="Cannot show image" Style="{DynamicResource Text.Warn}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding Source, ElementName=thumb, Converter={StaticResource HiddenWhen}}"/>
                                    </Grid>
                                    <TextBlock Text="Missing file" Style="{DynamicResource Text.Warn}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding Exists, Converter={StaticResource HiddenWhen}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Related elements -->
                <DockPanel Grid.Row="5" Margin="0,14,0,6"
                           DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock DockPanel.Dock="Left" Text="Related elements" Style="{DynamicResource Text.Heading}" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="Select in Revit" Command="{Binding SelectElementsCommand}"
                            ToolTip="Select and show these elements in the active Revit view"/>
                    <Border/>
                </DockPanel>
                <ListBox Grid.Row="6" Height="96" ItemsSource="{Binding ElementUniqueIds}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{DynamicResource Text.Code}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <!-- ===================== Footer ===================== -->
        <Border Grid.Row="3" Style="{DynamicResource Surface.Footer}">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="New issue" Command="{Binding NewIssueCommand}"
                        Style="{DynamicResource Button.Primary}"
                        ToolTip="Create an issue for the elements selected in Revit"/>
                <Button DockPanel.Dock="Left" Content="Delete issue" Command="{Binding DeleteIssueCommand}" Margin="8,0,0,0"
                        Style="{DynamicResource Button.Danger}"/>
                <Button DockPanel.Dock="Right" Content="Export PDF…" Command="{Binding ExportPdfCommand}"
                        ToolTip="Write all issues of the collection to a PDF file"/>
                <TextBlock Text="{Binding StatusText}" Style="{DynamicResource Text.Muted}"
                           VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
