<!-- Asks for one or more labelled texts (new collection, collection properties). -->
<Window x:Class="ModelessForms.IssuesManager.Views.TextFieldsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <DockPanel Margin="18,16,18,14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" MinWidth="90" IsDefault="True" Click="OnOk" Style="{DynamicResource Button.Primary}"/>
            <Button Content="Cancel" MinWidth="90" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
        <ItemsControl x:Name="Fields" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding Label}" Style="{DynamicResource Text.Secondary}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Loaded="OnFieldLoaded"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
</Window>
