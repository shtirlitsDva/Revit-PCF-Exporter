<!--
    Norsyn central colour tokens  (Colors.xaml)
    ===========================================
    THE single source of truth for every colour used by any Norsyn Revit add-in
    surface: the classic windows (via Theme.xaml's control styles) and the Command
    Palette dockable panes. If a colour is not here, it does not exist.
    Dark mode only. There is no light theme and no theme switching.

    HOW IT IS CONSUMED
      * Classic windows: ThemeManager loads this dictionary (embedded logical name
        "RevitShared.Colors.xaml") together with Theme.xaml at RUNTIME via XamlReader,
        because the .NET Framework 4.8 Revit projects have no XAML compile step.
        Theme.xaml references these brushes with {DynamicResource}, because they live
        in this separate dictionary and are only merged at apply time.
      * Command Palette (CommandPalette.Core): this same file is compiled in as a
        Page and merged via {StaticResource}. KEY NAMES ARE THEREFORE A CONTRACT:
        renaming a key breaks the Command Palette build.

    PALETTE
      Neutral cool gray, modelled on the Autodesk dark UI. One accent (a muted blue)
      for selection, focus and the primary action. Status colours are used only when
      they carry meaning (danger / success / warning), never as decoration.

    NOTE
      Flat, brushes-only dictionary: no cross-references between entries, so it
      loads standalone under XamlReader.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces, darkest -> lightest -->
    <SolidColorBrush x:Key="Brush.Bg.SurfaceLo"  Color="#1E2124"/>  <!-- recessed: input wells (ruleset BackgroundDeep) -->
    <SolidColorBrush x:Key="Brush.Bg.Window"     Color="#1E2124"/>  <!-- outermost window background -->
    <SolidColorBrush x:Key="Brush.Bg.Panel"      Color="#2A2D31"/>  <!-- panels, side bars, headers -->
    <SolidColorBrush x:Key="Brush.Bg.Surface"    Color="#33373C"/>  <!-- default control background -->
    <SolidColorBrush x:Key="Brush.Bg.SurfaceHi"  Color="#3D4248"/>  <!-- hover surface -->
    <SolidColorBrush x:Key="Brush.Bg.Highlight"  Color="#4A5159"/>  <!-- pressed / inactive selection -->

    <!-- Borders -->
    <SolidColorBrush x:Key="Brush.Hairline"      Color="#262A2E"/>  <!-- 1 px separators inside a panel -->
    <SolidColorBrush x:Key="Brush.Border"        Color="#4A5159"/>  <!-- control outlines -->
    <SolidColorBrush x:Key="Brush.BorderHi"      Color="#5C6470"/>  <!-- hover outline / emphasis -->

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.Text.Primary"   Color="#E8E8E8"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#BFBFBF"/>  <!-- labels, captions -->
    <SolidColorBrush x:Key="Brush.Text.Muted"     Color="#8A9099"/>  <!-- hints, ids, placeholders -->
    <SolidColorBrush x:Key="Brush.Text.Disabled"  Color="#6B7079"/>

    <!-- The single accent: selection, keyboard focus, primary action -->
    <SolidColorBrush x:Key="Brush.Accent"        Color="#4A6B8A"/>
    <SolidColorBrush x:Key="Brush.Accent.Hover"  Color="#5A7B9A"/>
    <SolidColorBrush x:Key="Brush.Accent.Press"  Color="#3A5B7A"/>
    <SolidColorBrush x:Key="Brush.Accent.Fg"     Color="#E8E8E8"/>  <!-- text on accent / status fills (ruleset TextPrimary) -->
    <SolidColorBrush x:Key="Brush.Accent.Translucent" Color="#404A6B8A"/>  <!-- selection area fill: Accent at 25 % opacity -->

    <!-- Screen-capture overlay: dims the screen behind the region selection -->
    <SolidColorBrush x:Key="Brush.Overlay.Dim"   Color="#80000000"/>

    <!-- Status: fills and outlines. Only where the meaning is real. -->
    <SolidColorBrush x:Key="Brush.Status.Success"     Color="#4A7C59"/>
    <SolidColorBrush x:Key="Brush.Status.Warning"     Color="#B8862B"/>
    <SolidColorBrush x:Key="Brush.Status.Danger"      Color="#B94A4A"/>

    <!-- Feedback TEXT (warnings in a window): the ruleset StatusWarning, readable on the dark background. -->
    <SolidColorBrush x:Key="Brush.Warn"          Color="#B8862B"/>

    <!-- Semantic axis colours (desaturated for a dark ground) -->
    <SolidColorBrush x:Key="Brush.Axis.X"        Color="#E6746B"/>
    <SolidColorBrush x:Key="Brush.Axis.Y"        Color="#7FC08A"/>
    <SolidColorBrush x:Key="Brush.Axis.Z"        Color="#6FA0E0"/>

    <!-- Command Palette: the favourite star. Warm gold reads as "pinned". -->
    <SolidColorBrush x:Key="Brush.Palette.Star"  Color="#E2B93B"/>

</ResourceDictionary>
